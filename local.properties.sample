# Copy this file to "local.properties" and fill in the values below.
# "local.properties" is gitignored and must never be committed.

# sdk.dir is auto-generated by Android Studio on first sync; you usually don't need to set it manually.
# sdk.dir=/path/to/your/Android/sdk

# GitHub OAuth App Client ID (Settings > Developer settings > OAuth Apps).
# "Enable Device Flow" must be checked on the OAuth App, or authentication will fail.
GITHUB_CLIENT_ID=